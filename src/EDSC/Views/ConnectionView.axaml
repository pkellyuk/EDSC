<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDSC.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="EDSC.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

    <Design.DataContext>
        <vm:ConnectionViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="20">

            <!-- Header -->
            <TextBlock Text="EDSC - Elite Dangerous Ship Controls"
                       FontSize="18"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <TextBlock Text="Web Control"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,10,0,0"/>

            <!-- Status Message -->
            <Border Background="#1F2937"
                    Padding="10"
                    CornerRadius="5"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#F9FAFB"/>
            </Border>

            <!-- QR Code for Web UI -->
            <Border Background="#111827"
                   Padding="10"
                   CornerRadius="5"
                   Margin="0,10,0,0"
                   IsVisible="{Binding ShowQrCode}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Web Control (no install)"
                              FontWeight="Bold"
                              FontSize="14"
                              Foreground="#F9FAFB"/>
                    <TextBlock Text="Scan this QR code to open the browser UI."
                              FontSize="12"
                              Foreground="#D1D5DB"
                              TextWrapping="Wrap"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Select IP address"
                                  FontSize="12"
                                  Foreground="#D1D5DB"/>
                        <ComboBox ItemsSource="{Binding LocalIpAddresses}"
                                  SelectedItem="{Binding SelectedLocalIpAddress}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Image Source="{Binding QrCodeImage}"
                           Width="200"
                           Height="200"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding QrCodeUrl}"
                              FontSize="11"
                              Foreground="#D1D5DB"
                              TextWrapping="Wrap"
                              TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Face Tracking Preview -->
            <Border Background="#111827"
                   Padding="10"
                   CornerRadius="5"
                   Margin="0,10,0,0"
                   IsVisible="{Binding ShowVideoPreview}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Face Tracking Preview"
                              FontWeight="Bold"
                              FontSize="14"
                              Foreground="#F9FAFB"/>
                    <TextBlock Text="{Binding VideoStatusText}"
                              FontSize="12"
                              Foreground="#D1D5DB"/>
                    <Image Source="{Binding VideoFrameImage}"
                           Width="480"
                           Height="360"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="FPS:"
                                  FontSize="12"
                                  Foreground="#D1D5DB"/>
                        <TextBlock Text="{Binding VideoFps}"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  Foreground="#10B981"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Help Text -->
            <Border Background="#1E293B"
                   Padding="10"
                   CornerRadius="5"
                   Margin="0,10,0,0">
                <StackPanel Spacing="5">
                    <TextBlock Text="How it works"
                              FontWeight="Bold"
                              FontSize="14"
                              Foreground="#F9FAFB"/>
                    <TextBlock TextWrapping="Wrap"
                              FontSize="12"
                              Foreground="#E5E7EB">
                        <Run Text="1. Keep EDSC running on your PC"/>
                        <LineBreak/>
                        <Run Text="2. Pick the correct IP address"/>
                        <LineBreak/>
                        <Run Text="3. Scan the QR code with your phone"/>
                        <LineBreak/>
                        <Run Text="4. Use the browser UI to press buttons"/>
                        <LineBreak/>
                        <Run Text="5. Click 'Face Tracking' to start video streaming"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
