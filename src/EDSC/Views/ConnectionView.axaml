<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDSC.ViewModels"
             xmlns:controls="using:EDSC.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="EDSC.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

    <Design.DataContext>
        <vm:ConnectionViewModel />
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="10,5">
            <TextBlock Text="EDSC - Elite Dangerous Ship Controls"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Center"/>
            <TextBlock Text="Web Control + Face Tracking"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Foreground="#9AA4B2"/>
        </StackPanel>

        <!-- Status Message -->
        <Border Grid.Row="1"
                Background="#1F2937"
                Padding="8"
                CornerRadius="5"
                Margin="10,0"
                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#F9FAFB"/>
        </Border>

        <!-- Main Content - Three Column Layout: QR | Tracking controls | Preview -->
        <Grid Grid.Row="2" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: QR Code -->
            <Border Grid.Column="0"
                    Background="#111827"
                    Padding="10"
                    CornerRadius="5"
                    Margin="0,0,5,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowQrCode}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Web Control (no install)"
                              FontWeight="Bold"
                              FontSize="13"
                              Foreground="#F9FAFB"/>
                    <TextBlock Text="Scan QR code with phone"
                              FontSize="11"
                              Foreground="#D1D5DB"
                              TextWrapping="Wrap"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Select IP address"
                                  FontSize="11"
                                  Foreground="#D1D5DB"/>
                        <ComboBox ItemsSource="{Binding LocalIpAddresses}"
                                  SelectedItem="{Binding SelectedLocalIpAddress}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Image Source="{Binding QrCodeImage}"
                           Width="200"
                           Height="200"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5"/>
                    <Button Content="{Binding QrCodeUrl}"
                            Command="{Binding OpenUrlCommand}"
                            HorizontalAlignment="Center"
                            Padding="0"
                            Margin="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock Text="{Binding QrCodeUrl}"
                                          FontSize="10"
                                          Foreground="#60A5FA"
                                          TextWrapping="Wrap"
                                          TextAlignment="Center"
                                          TextDecorations="Underline"
                                          Cursor="Hand"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- SSL Certificate Section -->
                    <Border Background="#1E293B"
                            Padding="8"
                            CornerRadius="5"
                            Margin="0,10,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SSL Certificate"
                                      FontWeight="Bold"
                                      FontSize="11"
                                      Foreground="#F9FAFB"/>
                            <TextBlock Text="{Binding CertificateStatus}"
                                      FontSize="10"
                                      Foreground="#9CA3AF"
                                      TextWrapping="Wrap"/>
                            <Button Content="Install SSL Certificate"
                                    Command="{Binding InstallCertificateCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6"
                                    FontSize="11"
                                    Background="#10B981"
                                    Foreground="White"
                                    CornerRadius="4"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 2: Tracking controls -->
            <Border Grid.Column="1"
                    Background="#111827"
                    Padding="10"
                    CornerRadius="5"
                    Margin="5,0,5,0"
                    VerticalAlignment="Top">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tracking Sensitivity"
                              FontWeight="Bold"
                              FontSize="13"
                              Foreground="#F9FAFB"/>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Position"
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.1" Maximum="25" SmallChange="0.5" LargeChange="2"
                                Value="{Binding TranslationScale}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TranslationScale, StringFormat='{}{0:0.00}x'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,0,6" MinWidth="44"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Yaw"
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="1"
                                Value="{Binding YawScale}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding YawScale, StringFormat='{}{0:0.00}x'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,0,6" MinWidth="44"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pitch"
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="1"
                                Value="{Binding RotationScale}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RotationScale, StringFormat='{}{0:0.00}x'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,0,6" MinWidth="44"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Roll"
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.1" Maximum="5" SmallChange="0.1" LargeChange="1"
                                Value="{Binding RollScale}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RollScale, StringFormat='{}{0:0.00}x'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,0,6" MinWidth="44"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Smoothing"
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="0.95" SmallChange="0.01" LargeChange="0.05"
                                Value="{Binding SmoothingStrength}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SmoothingStrength, StringFormat='{}{0:0%}'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" MinWidth="44"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Eye nudge left/right"
                                  ToolTip.Tip="Adds a fraction of your sideways eye movement to head yaw. Phone-side tracking only. 0% turns it off."
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,6,8,6"/>
                        <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding GazeNudgeYaw}" Margin="0,6,8,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding GazeNudgeYaw, StringFormat='{}{0:0%}'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,6,0,6" MinWidth="44"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Eye nudge up/down"
                                  ToolTip.Tip="Adds a fraction of your up/down eye movement to head pitch. Eyes move less vertically, so this usually wants a higher setting than left/right. 0% turns it off."
                                  FontSize="11" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.25"
                                Value="{Binding GazeNudgePitch}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding GazeNudgePitch, StringFormat='{}{0:0%}'}"
                                  FontSize="11" Foreground="#10B981" VerticalAlignment="Center" MinWidth="44"/>
                    </Grid>

                    <CheckBox Content="Show face mesh preview"
                              IsChecked="{Binding ShowPcPreview}"
                              ToolTip.Tip="Draws the tracked face mesh in the preview panel. The camera image never leaves the phone in phone-tracking mode. Off also stops the phone sending mesh frames."
                              FontSize="11"
                              Foreground="#D1D5DB"
                              Margin="0,6,0,0"/>

                    <Button Content="Reset tracking settings to defaults"
                            Command="{Binding ResetTrackingCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,6"
                            FontSize="11"
                            Background="#374151"
                            Foreground="White"
                            CornerRadius="4"
                            Margin="0,6,0,0"/>

                    <!-- Pose Output -->
                    <Border Background="#1E293B"
                            Padding="8"
                            CornerRadius="5"
                            Margin="0,8,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Pose Output"
                                      FontWeight="Bold"
                                      FontSize="12"
                                      Foreground="#F9FAFB"/>
                            <CheckBox IsChecked="{Binding DirectOutputEnabled}"
                                      FontSize="11"
                                      Foreground="#E5E7EB">
                                <TextBlock Text="Send directly to game (bypass Opentrack)"
                                          TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{Binding DirectOutputStatus}"
                                      FontSize="10"
                                      Foreground="#9CA3AF"
                                      TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Button Grid.Column="0"
                                        Content="{Binding CenterButtonText}"
                                        Command="{Binding CenterCommand}"
                                        IsEnabled="{Binding DirectOutputEnabled}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6"
                                        FontSize="11"
                                        Background="#2563EB"
                                        Foreground="White"
                                        CornerRadius="4"/>
                                <Button Grid.Column="1"
                                        Content="{Binding ChangeHotkeyButtonText}"
                                        Command="{Binding ChangeCenterHotkeyCommand}"
                                        Padding="8,6"
                                        FontSize="11"
                                        Background="#374151"
                                        Foreground="White"
                                        CornerRadius="4"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Help -->
                    <Border Background="#1E293B"
                            Padding="8"
                            CornerRadius="5"
                            Margin="0,8,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="How it works"
                                      FontWeight="Bold"
                                      FontSize="12"
                                      Foreground="#F9FAFB"/>
                            <TextBlock TextWrapping="Wrap"
                                      FontSize="11"
                                      Foreground="#E5E7EB"
                                      Text="1. Keep EDSC running on your PC.  2. Select your IP address.  3. Scan the QR code with your phone.  4. Press 'Face Tracking' on the phone. Use the Buttons tab to arrange the phone controls."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 3: Face Tracking Preview -->
            <Border Grid.Column="2"
                    Background="#111827"
                    Padding="10"
                    CornerRadius="5"
                    Margin="5,0,0,0"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding ShowVideoPreview}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,8">
                        <TextBlock Text="Face Tracking Preview"
                                  FontWeight="Bold"
                                  FontSize="13"
                                  Foreground="#F9FAFB"/>
                        <TextBlock Text="{Binding VideoStatusText}"
                                  FontSize="11"
                                  Foreground="#D1D5DB"
                                  TextWrapping="Wrap"/>
                    </StackPanel>

                    <Viewbox Grid.Row="1"
                             Stretch="Uniform"
                             StretchDirection="Both"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top">
                        <controls:FaceMeshView Frame="{Binding MeshFrame}"
                                               Indicator="{Binding GazeIndicator}"
                                               IsVisible="{Binding HasMeshFrame}"
                                               Width="480"/>
                    </Viewbox>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <TextBlock Text="FPS:"
                                  FontSize="11"
                                  Foreground="#D1D5DB"/>
                        <TextBlock Text="{Binding VideoFps}"
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Foreground="#10B981"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
