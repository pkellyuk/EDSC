<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:EDSC.Views"
        xmlns:dviews="using:EDSC.Desktop.Views"
        xmlns:desktop="using:EDSC.Desktop"
        x:Class="EDSC.Desktop.MainWindow"
        x:DataType="desktop:DesktopShellViewModel"
        Width="1240"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        Title="EDSC"
        Icon="/Assets/edsc.ico"
        WindowStartupLocation="CenterScreen">
    <TabControl Padding="0">
        <TabItem Header="Tracking">
            <views:ConnectionView DataContext="{Binding Connection}" />
        </TabItem>
        <TabItem Header="Buttons">
            <dviews:ButtonEditorView DataContext="{Binding ButtonEditor}" />
        </TabItem>
    </TabControl>
</Window>
