using Avalonia;
using Avalonia.Controls.ApplicationLifetimes;
using Avalonia.Markup.Xaml;
using EDSC.Services.Discovery;
using EDSC.Models;
using System;
using System.Diagnostics;
using System.Threading.Tasks;

namespace EDSC.Desktop
{
    /// <summary>
    /// Example PC application entry point showing discovery service integration
    /// </summary>
    public class App : Application
    {
        private IDiscoveryService _discoveryService;
        private ServerConfig _serverConfig;
        // Add other services here (HTTP server, keyboard service, etc.)

        public override void Initialize()
        {
            Debug.WriteLine("[App] Entry: Initialize");

            AvaloniaXamlLoader.Load(this);

            Debug.WriteLine("[App] Exit: Initialize");
        }

        public override async void OnFrameworkInitializationCompleted()
        {
            Debug.WriteLine("[App] Entry: OnFrameworkInitializationCompleted");

            if (ApplicationLifetime == null)
            {
                Debug.WriteLine("[App] ApplicationLifetime is null");
                base.OnFrameworkInitializationCompleted();
                return;
            }

            if (ApplicationLifetime is IClassicDesktopStyleApplicationLifetime desktop)
            {
                try
                {
                    // Load configuration
                    _serverConfig = LoadConfiguration();

                    if (_serverConfig == null)
                    {
                        Debug.WriteLine("[App] Failed to load configuration, using defaults");
                        _serverConfig = new ServerConfig();
                    }

                    Debug.WriteLine($"[App] Server config: {_serverConfig}");

                    // Initialize discovery service
                    _discoveryService = new UdpDiscoveryService(_serverConfig);

                    // Start discovery service if enabled
                    if (_serverConfig.EnableDiscovery)
                    {
                        Debug.WriteLine($"[App] Starting discovery service on port {_serverConfig.DiscoveryPort}");
                        await _discoveryService.StartListeningAsync(_serverConfig.DiscoveryPort);
                        Debug.WriteLine("[App] Discovery service started");
                    }
                    else
                    {
                        Debug.WriteLine("[App] Discovery service disabled in configuration");
                    }

                    // TODO: Start HTTP server for handling commands
                    // if (_serverConfig.AutoStart)
                    // {
                    //     await _httpServer.StartAsync(_serverConfig.Port);
                    // }

                    // TODO: Set up main window
                    // desktop.MainWindow = new MainWindow
                    // {
                    //     DataContext = new MainViewModel()
                    // };

                    Debug.WriteLine("[App] Application initialized successfully");
                }
                catch (Exception ex)
                {
                    Debug.WriteLine($"[App] Error during initialization: {ex.Message}");
                    // Consider showing error dialog to user
                }
            }

            base.OnFrameworkInitializationCompleted();
            Debug.WriteLine("[App] Exit: OnFrameworkInitializationCompleted");
        }

        /// <summary>
        /// Called when application is shutting down
        /// </summary>
        public override async void OnExit()
        {
            Debug.WriteLine("[App] Entry: OnExit");

            try
            {
                // Stop discovery service
                if (_discoveryService != null && _discoveryService.IsRunning)
                {
                    Debug.WriteLine("[App] Stopping discovery service");
                    await _discoveryService.StopListeningAsync();
                    Debug.WriteLine("[App] Discovery service stopped");
                }

                // TODO: Stop HTTP server
                // if (_httpServer != null)
                // {
                //     await _httpServer.StopAsync();
                // }
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[App] Error during shutdown: {ex.Message}");
            }

            base.OnExit();
            Debug.WriteLine("[App] Exit: OnExit");
        }

        /// <summary>
        /// Load server configuration from file
        /// </summary>
        private ServerConfig LoadConfiguration()
        {
            Debug.WriteLine("[App] Entry: LoadConfiguration");

            try
            {
                // TODO: Implement configuration loading from JSON file
                // For now, return default configuration
                var config = new ServerConfig
                {
                    Port = 5000,
                    DiscoveryPort = 5001,
                    AutoStart = true,
                    EnableDiscovery = true
                };

                Debug.WriteLine("[App] Configuration loaded successfully");
                return config;
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[App] Error loading configuration: {ex.Message}");
                return null;
            }
            finally
            {
                Debug.WriteLine("[App] Exit: LoadConfiguration");
            }
        }
    }
}
